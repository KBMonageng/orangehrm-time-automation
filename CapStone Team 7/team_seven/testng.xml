<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Team Seven Time Module Suite" verbose="1">
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.ClockInOutTest"/>
            <class name="tests.ViewAttendanceTest"/>
        </classes>
    </test>

    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="tests.EditTimesheetTest"/>
            <class name="tests.SubmitTimesheetTest"/>
            <class name="tests.ApprovalWorkflowTest"/>
        </classes>
    </test>
</suite>
